+// CamoufoxPageClockSegment is the page clock offset in milliseconds in effect
+// from a real time stamp on
+struct CamoufoxPageClockSegment {
+  TimeStamp mSince;
+  double mOffset;
+};
+
+// CamoufoxPageClock is the clock of one page: its offset segments in time
+// order and the latest time stamp the page has seen
+struct CamoufoxPageClock {
+  nsTArray<CamoufoxPageClockSegment> mSegments;
+  TimeStamp mObserved;
+};
+
+// kCamoufoxPageClockRetention is how long in seconds a segment is kept after
+// a later one takes effect, and a page clock after its page last saw the time
+constexpr double kCamoufoxPageClockRetention = 60;
+
+static StaticMutex sCamoufoxPageClockMutex MOZ_UNANNOTATED;
+static Atomic<bool, Relaxed> sCamoufoxPageClocksActive(false);
+static bool sCamoufoxPageClocksPrefChecked = false;
+static nsTHashMap<nsUint64HashKey, CamoufoxPageClock>* sCamoufoxPageClocks;
+
+// CamoufoxPageClockFor returns the clock of the page of the top-level browsing
+// context aTop, creating it; the caller holds sCamoufoxPageClockMutex
+CamoufoxPageClock& CamoufoxPageClockFor(uint64_t aTop) {
+  if (!sCamoufoxPageClocks) {
+    sCamoufoxPageClocks = new nsTHashMap<nsUint64HashKey, CamoufoxPageClock>();
+  }
+  return sCamoufoxPageClocks->LookupOrInsert(aTop);
+}
+
+// CamoufoxPageClockExpired reports whether aStamp is null or more than
+// kCamoufoxPageClockRetention seconds before aNow
+bool CamoufoxPageClockExpired(TimeStamp aStamp, TimeStamp aNow) {
+  return aStamp.IsNull() ||
+         (aNow - aStamp).ToSeconds() > kCamoufoxPageClockRetention;
+}
+
+// CamoufoxMapPageClock maps a real time stamp to the page time stamp: the
+// offset of the segment in effect at aStamp, capped by where the next segment
+// starts so that page time never decreases, and records it as seen
+TimeStamp CamoufoxMapPageClock(CamoufoxPageClock& aClock, TimeStamp aStamp) {
+  const nsTArray<CamoufoxPageClockSegment>& segments = aClock.mSegments;
+  size_t low = 0;
+  size_t high = segments.Length();
+  while (low < high) {
+    size_t middle = (low + high) / 2;
+    if (segments[middle].mSince <= aStamp) {
+      low = middle + 1;
+    } else {
+      high = middle;
+    }
+  }
+  double offset = low ? segments[low - 1].mOffset : 0;
+  TimeStamp result = aStamp + TimeDuration::FromMilliseconds(offset);
+  if (low < segments.Length()) {
+    TimeStamp limit = segments[low].mSince +
+                      TimeDuration::FromMilliseconds(segments[low].mOffset);
+    if (limit < result) {
+      result = limit;
+    }
+  }
+  if (aClock.mObserved.IsNull() || aClock.mObserved < result) {
+    aClock.mObserved = result;
+  }
+  return result;
+}
+
+}  // namespace
+
+TimeStamp nsDOMNavigationTiming::PageClockStamp(TimeStamp aStamp) const {
+  if (!PageClocksActive()) {
+    return aStamp;
+  }
+  if (!mPageClockTop && mDocShell) {
+    if (mozilla::dom::BrowsingContext* context =
+            mDocShell->GetBrowsingContext()) {
+      mPageClockTop = context->Top()->Id();
+    }
+  }
+  return PageClockStampFor(mPageClockTop, aStamp);
+}
+
+/* static */
+bool nsDOMNavigationTiming::PageClocksActive() {
+  if (!sCamoufoxPageClocksPrefChecked && NS_IsMainThread()) {
+    sCamoufoxPageClocksPrefChecked = true;
+    if (Preferences::GetBool("camoufox.virtual_input_time", false)) {
+      sCamoufoxPageClocksActive = true;
+    }
+  }
+  return sCamoufoxPageClocksActive;
+}
+
+/* static */
+TimeStamp nsDOMNavigationTiming::PageClockStampFor(uint64_t aTop,
+                                                   TimeStamp aStamp) {
+  if (!PageClocksActive() || !aTop || aStamp.IsNull()) {
+    return aStamp;
+  }
+  StaticMutexAutoLock lock(sCamoufoxPageClockMutex);
+  return CamoufoxMapPageClock(CamoufoxPageClockFor(aTop), aStamp);
+}
+
+/* static */
+double nsDOMNavigationTiming::GetPageClockOffset(uint64_t aTop) {
+  if (!sCamoufoxPageClocksActive) {
+    return 0;
+  }
+  StaticMutexAutoLock lock(sCamoufoxPageClockMutex);
+  CamoufoxPageClock* clock =
+      sCamoufoxPageClocks ? sCamoufoxPageClocks->Lookup(aTop).DataPtrOrNull()
+                          : nullptr;
+  if (!clock || clock->mSegments.IsEmpty()) {
+    return 0;
+  }
+  return clock->mSegments.LastElement().mOffset;
+}
+
+/* static */
+void nsDOMNavigationTiming::SetPageClockOffset(uint64_t aTop,
+                                               double aMilliseconds) {
+  StaticMutexAutoLock lock(sCamoufoxPageClockMutex);
+  TimeStamp now = TimeStamp::Now();
+  if (sCamoufoxPageClocks) {
+    for (auto iter = sCamoufoxPageClocks->Iter(); !iter.Done(); iter.Next()) {
+      const CamoufoxPageClock& other = iter.Data();
+      if (CamoufoxPageClockExpired(other.mObserved, now) &&
+          (other.mSegments.IsEmpty() ||
+           CamoufoxPageClockExpired(other.mSegments.LastElement().mSince,
+                                    now))) {
+        iter.Remove();
+      }
+    }
+  }
+  CamoufoxPageClock& clock = CamoufoxPageClockFor(aTop);
+  double offset = aMilliseconds;
+  if (!clock.mObserved.IsNull()) {
+    offset = std::max(offset, (clock.mObserved - now).ToMilliseconds());
+  }
+  size_t superseded = 0;
+  while (superseded + 1 < clock.mSegments.Length() &&
+         CamoufoxPageClockExpired(clock.mSegments[superseded + 1].mSince,
+                                  now)) {
+    superseded++;
+  }
+  clock.mSegments.RemoveElementsAt(0, superseded);
+  clock.mSegments.AppendElement(CamoufoxPageClockSegment{now, offset});
+  sCamoufoxPageClocksActive = true;
+}
